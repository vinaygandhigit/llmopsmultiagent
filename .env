LLM_PROVIDER=gemini/claude
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# LangSmith monitoring/observability. Set LANGSMITH_TRACING=true and fill in
# LANGSMITH_API_KEY (from https://smith.langchain.com/settings) to enable.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Multiagentbank
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- LLMOps controls (see .env.example for the full explanation of each) ---
LLMOPS_JUDGE_MODEL=claude-haiku-4-5-20251001
QUALITY_SCORING_ENABLED=true
QUALITY_SCORING_SAMPLE_RATE=1.0
GUARDRAILS_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
DAILY_TOKEN_BUDGET_PER_TENANT=50000
LATENCY_SLO_MS=8000
